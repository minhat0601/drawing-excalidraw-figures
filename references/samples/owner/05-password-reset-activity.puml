@startuml
title Password reset - Flow (basic)
start
:User clicks "Forgot password";
:Enter email;
if (Email exists?) then (yes)
  :Create reset token (15 min);
  :Send reset email;
else (no)
  :Do nothing (avoid email enumeration);
endif
:Show "Check your inbox";
:User opens link;
if (Token valid and not expired?) then (yes)
  :Enter new password;
  :Hash and save password;
  :Revoke all sessions;
else (no)
  :Show "Link expired";
endif
stop
@enduml
